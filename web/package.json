{
  "name": "mahi-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-tokens.mjs",
    "check-tokens": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs",
    "predev": "pnpm run tokens",
    "dev": "next dev",
    "prebuild": "pnpm run tokens && pnpm run check-tokens",
    "build": "next build",
    "lint": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-tokens.mjs --check && pnpm run check-tokens && eslint",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
