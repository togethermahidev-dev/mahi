{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "environment": "preview",
      "channel": "preview"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "733RLXDJNY"
      }
    },
    "testflight": {
      "extends": "production"
    }
  }
}
