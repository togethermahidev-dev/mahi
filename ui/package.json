{
  "name": "mahi-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "node ../node_modules/@typescript/native/bin/tsc --noEmit",
    "type-check": "pnpm typecheck",
    "test": "jest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "build:preview": "node ../scripts/release-check.cjs --release && npx -y eas-cli@24.7.0 build --profile preview --platform ios",
    "build:testflight": "node ../scripts/release-check.cjs --release && npx -y eas-cli@24.7.0 build --profile testflight --platform ios --auto-submit",
    "build:prod": "node ../scripts/release-check.cjs --release && npx -y eas-cli@24.7.0 build --profile production --platform ios",
    "submit:ios": "npx -y eas-cli@24.7.0 submit --profile production --platform ios",
    "ota:preview": "node ../scripts/release-check.cjs && node ../scripts/ota-publish.cjs preview",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "ota:prod": "node ../scripts/release-check.cjs && npx -y eas-cli@24.7.0 update --channel production --environment production --message",
    "eas:builds": "npx -y eas-cli@24.7.0 build:list --limit 10"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@didit-protocol/sdk-react-native": "4.9.0",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo/ui": "~57.0.21",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "^8.26.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-background-fetch": "~57.0.18",
    "expo-background-task": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.20",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-contacts": "~57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.18",
    "expo-notifications": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-task-manager": "~57.0.18",
    "expo-updates": "~57.0.22",
    "expo-video": "~57.0.5",
    "expo-widgets": "~57.0.23",
    "posthog-react-native": "^4.78.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "10.11.0",
    "react-native-purchases-ui": "10.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@sentry/expo-upload-sourcemaps": "8.26.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "jest",
        "@types/jest"
      ]
    }
  }
}
